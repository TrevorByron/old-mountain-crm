NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Personal access token with data.records:read and data.records:write on the base.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appHOiCPSEwIBMWFE
AIRTABLE_TABLE_ID=tblmuieQgmLOXGmzw
# Checkbox field that shows opt-outs in Airtable. Leave blank to skip.
AIRTABLE_OPT_OUT_FIELD_ID=fldOzBMeVkvltVrOE

RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Local only: skip sign-in and act as this team member while running `npm run dev`.
# DEV_AUTH_EMAIL=you@example.com
# Local only: talk to the Inngest dev server instead of Inngest Cloud. Never set in production.
# INNGEST_DEV=1
# Generate with: openssl rand -base64 32
UNSUBSCRIBE_TOKEN_SECRET=
APP_URL=http://localhost:3100
# Comma-separated origins allowed to post to /api/subscribe, e.g. https://www.example.com
SIGNUP_ALLOWED_ORIGINS=https://www.old-mountain.com,https://old-mountain.com
# Shown on the public unsubscribe page.
BRAND_NAME="Old Mountain Tours & Explorations"
SENDER_FROM="Trevor Borden <trevor@mail.old-mountain.com>"
# An inbox you read. Emails send from a subdomain with no mailbox, so replies come here.
SENDER_REPLY_TO=
SENDER_POSTAL_ADDRESS=
